        stats.targetCount = normalizedTargets.length;
        stats.eligibleCount = 0;
        stats.createdCount = 0;
        stats.removedCount = 0;
        stats.terminalCount = 0;

        if (groupId <= 0) {
            return stats;
        }

        for (index = 0; index < cleanupLayers.length; index += 1) {
            layer = cleanupLayers[index];
            if (isEligibleTarget(group, normalizedTargets, layer)) {
                stats.eligibleCount += 1;
            }

            try {
                syncTargetEffects(group, groupId, normalizedTargets, layer, records, stats);
            } catch (targetSyncError) {
