            }
        }

        rememberTargets(group, normalizedTargets);
        return stats;
    }

    function removeOwnedEffects(layers, groupId) {
        var normalizedLayers = normalizeLayers(layers);
        var normalizedGroupId = normalizePositiveInteger(groupId);
        var result = makePlainObject();
        var removedCount = 0;
        var index;
        var effects;

        result.removedCount = 0;
        if (normalizedGroupId === null) {
            return result;
        }

        delete previousTargetsByGroup[getGroupKey(normalizedGroupId)];
        for (index = 0; index < normalizedLayers.length; index += 1) {
            effects = getEffectsProperty(normalizedLayers[index]);
            if (effects === null || typeof effects === "undefined") {
                continue;
            }

            try {
                removedCount += removeOwnedFromEffects(effects, normalizedGroupId, null);
            } catch (removeError) {
