                        work.phase = "complete";
                        continue;
                    }
                    record = records[work.effectIndex];
                    effects = getEffectsProperty(layer);
                    copy = null;
                    created = false;
                    if (work.pendingEffectIndex > 0 &&
                            work.pendingEffectMatchName === record.matchName) {
                        copy = getCollectionItem(effects, work.pendingEffectIndex);
                        if ((copy === null || typeof copy === "undefined") &&
                                work.pendingEffectRef !== null &&
                                typeof work.pendingEffectRef !== "undefined" &&
                                collectionContains(effects, work.pendingEffectRef)) {
                            copy = work.pendingEffectRef;
                        }
                        if (copy === null || typeof copy === "undefined" ||
                                getEffectMatchName(copy) !== record.matchName) {
                            copy = null;
                            work.pendingEffectIndex = 0;
                            work.pendingEffectMatchName = "";
                            work.pendingEffectName = "";
                            work.pendingEffectRef = null;
                        } else {
                            created = true;
                        }
                    }
                    if (copy === null || typeof copy === "undefined") {
                        copy = findOwnedEffect(effects, entry.id, record.effectIndex);
                    }
                    if (copy !== null && getEffectMatchName(copy) !== record.matchName) {
                        if (!canUseHost(budget)) { return; }
                        if (!removeEffect(effects, copy)) { return; }
                        stats.removedCount += 1;
                        return;
                    }
                    if (copy === null || typeof copy === "undefined") {
                        if (!consumeEffectAdd(stats, budget)) { return; }
                        copy = addEffectCopy(effects, record);
                        if (copy === null || typeof copy === "undefined") { return; }
                        created = true;
                        stats.createdCount += 1;
                        work.pendingEffectIndex = getCollectionCount(effects);
                        work.pendingEffectMatchName = record.matchName;
                        work.pendingEffectRef = copy;
                    }
                    reservedName = makeReservedEffectName(entry.id, record.effectIndex,
                        record.sourceName);
                    work.pendingEffectName = reservedName;
                    if (!setEffectNameBounded(copy, reservedName, budget, created)) { return; }
                    work.pendingEffectIndex = 0;
                    work.pendingEffectMatchName = "";
                    work.pendingEffectName = "";
                    work.pendingEffectRef = null;
                    if (created && !canUseHost(budget)) { return; }
                    work.effectJob = makePropertyJob(record, work.sourceKey, created);
                    continue;
                }
                return;
            }
        }

        function targetOne(stats, budget) {
            var entry;
            var group;
            var range;
            var rangeKey;
            var records;
            var sourceKey;
            var work;
            var layer;
            var targetIndex;
            var targetId;
            var cacheKey;
            var cached;
            var targetKey;
            var targets;
            var eligible;
            var complete;

            if (groups.length === 0) { return; }
            if (groupIndex >= groups.length) { groupIndex = 0; }
            entry = groups[groupIndex];
            groupIndex += 1;
            group = resolveGroupLayer(entry);
            if (group === null || typeof group === "undefined") { return; }
            range = currentRange(entry, group);
            rangeKey = range.startIndex + ":" + range.endIndex;
            records = getSourceRecords(group);
            sourceKey = shallowSignature(group, records);
            if (entry.rangeKey !== rangeKey || entry.sourceKey !== sourceKey) {
                resetEntryTargets(entry, range, sourceKey);
            }
            if (range.endIndex < range.startIndex) { return; }

            work = entry.targetWork;
            if (work !== null && typeof work !== "undefined") {
                if (work.rangeKey !== rangeKey || work.sourceKey !== sourceKey) {
                    entry.cursor = work.layerIndex;
                    entry.targetWork = null;
                    work = null;
                } else {
                    layer = readLayer(work.layerIndex);
                    if (getLayerId(layer) !== work.layerId) {
                        entry.cursor = work.layerIndex;
                        entry.targetWork = null;
                        work = null;
                    } else {
                        targets = membership(range);
                        eligible = isEligibleTarget(group, targets, layer);
                        if (work.eligible !== eligible) {
                            work.eligible = eligible;
                            work.phase = eligible ? "cleanup" : "removeAll";
                            work.effectIndex = 0;
                            work.effectJob = null;
                            work.preservedMap = {};
                            work.keepMap = null;
                            work.cleanupIndex = null;
                        }
                    }
                }
            }
            if (work === null || typeof work === "undefined") {
                if (entry.cursor < range.startIndex || entry.cursor > range.endIndex) {
                    entry.cursor = range.startIndex;
                }
                if (entry.cursor > range.endIndex) { return; }
                targetIndex = entry.cursor;
                entry.cursor += 1;
                layer = readLayer(targetIndex);
                if (layer === null || typeof layer === "undefined") {
                    entry.remaining = Math.max(0, entry.remaining - 1);
                    return;
                }
                targetId = getLayerId(layer);
                if (targetId <= 0) {
                    entry.remaining = Math.max(0, entry.remaining - 1);
                    return;
                }
                cacheKey = getGroupKey(targetId);
                targetKey = shallowSignature(layer, null);
                cached = entry.cache[cacheKey];
                targets = membership(range);
                eligible = isEligibleTarget(group, targets, layer);
                if (eligible && cached &&
                        cached.sourceKey === sourceKey && cached.targetKey === targetKey &&
                        nowValue() - cached.auditAt < limit(settings.auditIntervalMs, 5000)) {
                    stats.skippedTargets += 1;
                    entry.remaining = Math.max(0, entry.remaining - 1);
                    return;
                }
                work = {layerIndex: targetIndex, layerId: targetId,
                    rangeKey: rangeKey, sourceKey: sourceKey, targetKey: targetKey,
                    phase: eligible ? "cleanup" : "removeAll",
                    effectIndex: 0, effectJob: null, preservedMap: {}, keepMap: null,
                    cleanupIndex: null, pendingEffectIndex: 0,
                    pendingEffectMatchName: "", pendingEffectName: "", pendingEffectRef: null,
                    eligible: eligible};
                entry.targetWork = work;
            }
            processTargetWork(entry, group, layer, records, stats, budget);
            complete = entry.targetWork !== null && entry.targetWork.phase === "complete";
            if (complete) {
                cacheKey = getGroupKey(work.layerId);
                entry.cache[cacheKey] = {sourceKey: sourceKey, targetKey: work.targetKey,
                    auditAt: nowValue()};
                entry.targetWork = null;
                entry.remaining = Math.max(0, entry.remaining - 1);
            }
        }

        function pending() {
            var index;

            if (!discovered || cleanupRemaining > 0 || cleanupLayerId > 0) {
                return layerCount > 0;
            }
            for (index = 0; index < groups.length; index += 1) {
                if (groups[index].targetWork !== null &&
                        typeof groups[index].targetWork !== "undefined") { return true; }
                if (groups[index].remaining > 0 || groups[index].cursor === 0) { return true; }
            }
            return false;
        }

        function step(comp, budget) {
            var request = budget || {};
            var stats = emptyStats();
            var started = nowValue();
            var count;
            var keys;
            var index;
            var scanLimit = limit(request.maxDiscoveryLayers, limit(settings.maxDiscoveryLayers, 16));
            var targetLimit = limit(request.maxTargetLayers, limit(settings.maxTargetLayers, 2));
            var timeLimit = limit(request.timeBudgetMs, limit(settings.timeBudgetMs, 12));
            var propertyLimit = limitBudget(request.maxPropertyOperations,
                limitBudget(settings.maxPropertyOperations, 8));
            var effectAddLimit = limitBudget(request.maxEffectAdds,
                limitBudget(settings.maxEffectAdds, 1));
            var workBudget = {started: started, timeLimit: timeLimit,
                maxPropertyOperations: propertyLimit, maxEffectAdds: effectAddLimit,
                propertyOperations: 0, effectAddAttempts: 0, yielded: false,
                yieldReason: ""};

            if (comp !== activeComp || request.projectId !== projectId) {
                reset();
                activeComp = comp;
                projectId = request.projectId;
                started = nowValue();
                workBudget.started = started;
            }
            try { count = comp ? Number(comp.numLayers) : 0; } catch (countError) { count = 0; }
            count = isFinite(count) ? Math.max(0, Math.floor(count)) : 0;
            if (count !== layerCount) {
                layerCount = count;
                discoveryIndex = 1;
                generation += 1;
                discovered = false;
                discoveryInProgress = true;
                groups = [];
                byId = {};
                groupIndex = 0;
                cleanupIndex = 1;
                cleanupRemaining = count;
                cleanupLayerIndex = 0;
                cleanupLayerId = 0;
                cleanupEffectIndex = 0;
            }

            function hasTime() { return canUseHost(workBudget); }
            function scan() {
                var maximum = Math.min(scanLimit, layerCount);

                if (!discoveryInProgress) {
                    if (nowValue() < nextDiscoveryAt) { return; }
                    discoveryInProgress = true;
                }
                while (stats.discoveryLayers < maximum && discoveryInProgress && hasTime()) {
                    discoverOne(stats);
                }
            }
            function work() {
                while (layerCount > 0 && stats.targetLayers < targetLimit && hasTime()) {
                    stats.targetLayers += 1;
                    try {
                        if (groups.length === 0 || workSerial % 4 === 0) {
                            cleanupOne(stats, workBudget);
                        } else {
                            targetOne(stats, workBudget);
                        }
                    } catch (workError) { stats.errors += 1; }
                    workSerial += 1;
                    if (workBudget.yielded) { break; }
                }
            }
            if (preferWork) { work(); scan(); } else { scan(); work(); }
            preferWork = !preferWork;
            stats.yielded = workBudget.yielded;
            stats.yieldReason = workBudget.yieldReason;
            stats.pending = pending();
            stats.elapsedMs = Math.max(0, nowValue() - started);
            keys = ["discoveryLayers", "targetLayers", "terminalVisits", "terminalCount",
                "propertyOperations", "propertyWrites", "effectAddAttempts",
                "createdCount", "removedCount", "skippedTargets", "errors"];
            for (index = 0; index < keys.length; index += 1) {
                totals[keys[index]] += stats[keys[index]];
            }
            totals.ticks += 1;
            lastTick = stats;
            return stats;
        }

        function getStats() {
            return {lastTick: lastTick, totals: totals, pending: pending()};
        }
        reset();
        return {step: step, reset: reset, getStats: getStats};
    }

    return {
        makeReservedEffectName: makeReservedEffectName,
        parseReservedEffectName: parseReservedEffectName,
        buildEffectExpressionPath: buildEffectExpressionPath,
        getSourceEffects: getSourceEffects,
        syncGroupEffects: syncGroupEffects,
        createIncrementalSession: createIncrementalSession,
        removeOwnedEffects: removeOwnedEffects
    };
}());

if (typeof module !== "undefined" && module !== null && module.exports) {
    module.exports = GroupControlEffectSync;
}
