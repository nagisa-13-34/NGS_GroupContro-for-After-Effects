        return result;
    }

    /* The idle watcher never calls syncGroupEffects: it discovers a bounded
     * slice, then visits current target Layers and individual Properties.
     * Persistent state contains only indexes, paths, and signatures. */
    function createIncrementalSession(options) {
        var settings = options || {};
        var clockNow = settings.now || function () { return new Date().getTime(); };
        var activeComp = null;
        var projectId = null;
        var layerCount = 0;
        var discoveryIndex = 1;
        var cleanupIndex = 1;
        var cleanupRemaining = 0;
        var cleanupLayerIndex = 0;
        var cleanupLayerId = 0;
        var cleanupEffectIndex = 0;
        var generation = 1;
        var discovered = false;
        var discoveryInProgress = true;
        var nextDiscoveryAt = 0;
        var groups = [];
        var byId = {};
        var groupIndex = 0;
        var workSerial = 0;
        var preferWork = false;
        var lastTick = null;
        var totals;

        function limit(value, fallback) {
            value = Number(value);
            return isFinite(value) && value > 0 ? Math.max(1, Math.floor(value)) : fallback;
        }

        function limitBudget(value, fallback) {
            value = Number(value);
            return isFinite(value) && value >= 0 ? Math.floor(value) : fallback;
        }

        function emptyStats() {
            return {discoveryLayers: 0, targetLayers: 0, terminalVisits: 0,
                terminalCount: 0, propertyOperations: 0, propertyWrites: 0,
                effectAddAttempts: 0, effectAdds: 0, createdCount: 0, removedCount: 0,
                skippedTargets: 0, errors: 0, pending: false, yielded: false,
                yieldReason: "", elapsedMs: 0};
        }

        function reset() {
            activeComp = null;
            projectId = null;
            layerCount = 0;
            discoveryIndex = 1;
            cleanupIndex = 1;
            cleanupRemaining = 0;
            cleanupLayerIndex = 0;
            cleanupLayerId = 0;
            cleanupEffectIndex = 0;
            generation = 1;
            discovered = false;
            discoveryInProgress = true;
            nextDiscoveryAt = 0;
            groups = [];
            byId = {};
            groupIndex = 0;
            workSerial = 0;
            preferWork = false;
